4. SQL JOIN Queries
4.1 INNER JOIN
SELECT c.customer_name, p.product_name, s.quantity
FROM sales s
INNER JOIN customers c ON s.customer_id = c.customer_id
INNER JOIN products p ON s.product_id = p.product_id;

4.2 LEFT JOIN (Customers with no purchases)
SELECT c.customer_name
FROM customers c
LEFT JOIN sales s ON c.customer_id = s.customer_id
WHERE s.sale_id IS NULL;

4.3 RIGHT JOIN (Products never sold)
SELECT p.product_name
FROM sales s
RIGHT JOIN products p ON s.product_id = p.product_id
WHERE s.sale_id IS NULL;

4.4 FULL OUTER JOIN (MySQL-compatible version using UNION)
SELECT c.customer_name, p.product_name
FROM customers c
LEFT JOIN products p ON c.customer_id = p.product_id
UNION
SELECT c.customer_name, p.product_name
FROM customers c
RIGHT JOIN products p ON c.customer_id = p.product_id;

4.5 SELF JOIN (Customers visiting same day)
SELECT c1.customer_name AS customer1,
       c2.customer_name AS customer2,
       c1.visit_date
FROM customers c1
JOIN customers c2
ON c1.visit_date = c2.visit_date
AND c1.customer_id <> c2.customer_id;

5. Window Functions
5.1 RANK() – Top-selling drinks by day type
SELECT p.product_name,
       c.day_type,
       SUM(s.quantity) AS total_sold,
       RANK() OVER (PARTITION BY c.day_type ORDER BY SUM(s.quantity) DESC) AS sales_rank
FROM sales s
JOIN customers c ON s.customer_id = c.customer_id
JOIN products p ON s.product_id = p.product_id
GROUP BY p.product_name, c.day_type;

5.2 SUM() OVER() – Running total of daily sales
SELECT sale_date,
       SUM(quantity) AS daily_sales,
       SUM(SUM(quantity)) OVER (ORDER BY sale_date) AS running_total
FROM sales
GROUP BY sale_date;

5.3 LAG() – Day-to-day sales comparison
SELECT sale_date,
       SUM(quantity) AS daily_sales,
       LAG(SUM(quantity)) OVER (ORDER BY sale_date) AS previous_day_sales
FROM sales
GROUP BY sale_date;

5.4 NTILE(4) – Customer purchase segmentation
SELECT customer_id,
       SUM(quantity) AS total_items,
       NTILE(4) OVER (ORDER BY SUM(quantity)) AS customer_quartile
FROM sales
GROUP BY customer_id;


